# Pushes the wiki to its private git remote. See docs/OPERATIONS.md (Wiki backup).
# Replace the user and paths, then copy both units to /etc/systemd/system/.
[Unit]
Description=Secretary wiki sync (git push to a private remote)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=youruser
Environment=WIKI_DIR=/home/youruser/secretary-data/wiki
# Environment=WIKI_SYNC_PING_FILE=/home/youruser/.config/secretary-wiki-sync/ping-url
ExecStart=/home/youruser/secretary-llm/scripts/wiki-sync.sh
Nice=10
