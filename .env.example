# Copy to .env (ignored by git). Never commit real values.

# Directory holding all personal data (DB, wiki, config). Outside the repo.
SECRETARY_DATA_DIR=~/secretary-data

# LLM provider: fake | api | subscription
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Google Calendar (OAuth). Credential files live in SECRETARY_DATA_DIR/secrets/
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_CALENDAR_ID=primary

# Notion (migration only)
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
NOTION_COURSES_DB_ID=
NOTION_STUDY_PLAN_DB_ID=
NOTION_APPLICATIONS_DB_ID=

# Litestream -> encrypted bucket (R2 / B2)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=

# Tailscale
TS_AUTHKEY=
