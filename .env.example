# Copy to .env (ignored by git). Never commit real values.

# Directory holding all personal data, outside the repo. Layout:
#   db/          SQLite database (replicated by Litestream)
#   config/      config.yaml: enable/disable modules, change their models (optional)
#   tailscale/   Tailscale sidecar state (only with compose.tailscale.yml)
#   wiki/        Markdown memory (its own private git repo)
#   secrets/     google-service-account.json and other credentials (mounted read-only)
#   models/      speech-to-text models, downloaded on first use (~500 MB for "small")
SECRETARY_DATA_DIR=../secretary-data

# Timezone for "today", due dates and the agent's date context (IANA name, e.g. America/New_York)
SECRETARY_TIMEZONE=UTC

# LLM provider:
#   fake          no model, runs offline
#   subscription  your Claude Pro/Max plan through the Claude Agent SDK (counts against plan limits)
#   api           Anthropic API, billed per token
LLM_PROVIDER=fake
# subscription: token from `claude setup-token` (valid one year)
CLAUDE_CODE_OAUTH_TOKEN=
# api: key from the Anthropic Console
ANTHROPIC_API_KEY=
# Orchestrator model: haiku | sonnet | opus, or a full model ID. Modules set theirs in module.yaml.
SECRETARY_ORCHESTRATOR_MODEL=

# Google Calendar through a service account (see docs/OPERATIONS.md).
# The key goes in SECRETARY_DATA_DIR/secrets/google-service-account.json.
# Calendar ID: for your main calendar, your Google account's email address.
GOOGLE_CALENDAR_ID=

# Notion import (secretary import notion): internal integration token.
# Database ids and field mapping go in SECRETARY_DATA_DIR/config/notion.yaml.
NOTION_TOKEN=

# Litestream -> S3-compatible bucket (R2 / B2)
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region: auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto

# Voice: faster-whisper model (tiny | base | small | medium) and language (e.g. es; empty = auto)
WHISPER_MODEL=small
WHISPER_LANGUAGE=

# Host port for the app (bound to 127.0.0.1 only)
APP_PORT=8000

# Only for the optional Tailscale sidecar (compose.tailscale.yml)
TS_AUTHKEY=
TS_HOSTNAME=secretary
